FROM public.ecr.aws/lambda/python:3.12

# Install uv for fast dependency resolution
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Install dependencies into the Lambda system Python (not a venv).
# Export the lockfile to requirements.txt and pip-install into the system
# site-packages. Lambda's runtime uses /var/lang/bin/python3.12.
COPY pyproject.toml uv.lock ./
RUN uv export --frozen --no-dev --no-hashes -o requirements.txt && \
    uv pip install --system -r requirements.txt mangum asgiref

# Copy application code
COPY fintrack/ ./fintrack/
COPY web/ ./web/
COPY configs/ ./configs/
COPY migrations/ ./migrations/
COPY scripts/ ./scripts/
COPY fintrack.py ./
COPY lambda_handler.py ./
COPY alembic.ini ./

CMD ["lambda_handler.handler"]
